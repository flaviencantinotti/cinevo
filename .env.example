# Copiez ce fichier en « .env » puis renseignez votre clé TMDB.
# La clé s'obtient gratuitement sur https://www.themoviedb.org/settings/api

TMDB_API_KEY=votre_cle_api_ici

# Ces deux valeurs ont déjà les bons défauts, inutile d'y toucher.
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p

# Uniquement si HTTPS échoue sous WAMP/XAMPP (« SSL certificate problem ») :
# indiquez le chemin complet vers un fichier cacert.pem.
# TMDB_CA_BUNDLE=C:/wamp64/bin/php/cacert.pem
